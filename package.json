{
  "private": true,
  "name": "blog",
  "version": "0.0.1",
  "description": "Personal web development laboratory",
  "license": "MIT",
  "author": "Marcos Gil <marcosgilf.com>",
  "homepage": "https://marcosgilf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcosgilf/blog.git",
    "https": "https://github.com/marcosgilf/blog.git",
    "editUrl": "https://github.com/marcosgilf/blog/-/edit/master"
  },
  "bugs": {
    "url": "https://github.com/marcosgilf/blog/issues"
  },
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dependencies:check": "ncu -e 2 --reject @netlify/blobs",
    "dependencies:update": "ncu -u --reject @netlify/blobs && npm i",
    "dev": "astro dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "vitest run",
    "test:coverage": "npm run test -- --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/netlify": "^8.2.11",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@netlify/blobs": "^10.7.9",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "^14.0.3"
    },
    "minimatch": "^11.0.4"
  },
  "keywords": [
    "astro",
    "markdown",
    "modern-web"
  ]
}
